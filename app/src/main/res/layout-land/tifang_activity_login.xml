<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/login_bg_pad"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        tools:context=".login.LoginActivity">

        <RelativeLayout
            android:id="@+id/logo_root"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">

            <RelativeLayout
                android:id="@+id/logo_rl"
                android:layout_width="300dp"
                android:layout_height="170dp"
                android:layout_marginTop="@dimen/logo_margin_top">

                <ImageView
                    android:id="@+id/logo_book"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:background="@drawable/login_book" />

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="224dp"
                    android:layout_height="116dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/tifang_logo" />

            </RelativeLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlContent"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/logo_root"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_20">

            <!--账号密码登录页面-->
            <LinearLayout
                android:id="@+id/llNormalLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_40"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/username_icon" />

                        <EditText
                            android:id="@+id/et_username"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:ems="10"
                            android:hint="@string/loginname_hint"
                            android:text="1865yxfs"
                            android:includeFontPadding="false"
                            android:inputType="textPersonName"
                            android:textColor="#333333"
                            android:textColorHint="@color/login_grey"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <View
                        android:id="@+id/line_usernmae"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="#6b6b6b6b" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_40"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/password_icon" />

                        <EditText
                            android:id="@+id/et_pwd"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:ems="10"
                            android:hint="@string/input_pwd"
                            android:includeFontPadding="false"
                            android:textColor="#333333"
                            android:textColorHint="@color/login_grey"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <View
                        android:id="@+id/line_pwd"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="#6b6b6b6b" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/check_box_teacher"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:background="@null"
                        android:checked="true"
                        android:padding="@dimen/dp_10"
                        android:src="@drawable/checkbox_remember_password_selector" />

                    <TextView
                        android:id="@+id/text_teacher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="40dp"
                        android:text="教师"
                        android:textColor="@color/text_color_second"
                        android:textSize="@dimen/sp_14" />

                    <CheckBox
                        android:id="@+id/check_box_student"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:background="@null"
                        android:checked="false"
                        android:padding="@dimen/dp_10"
                        android:src="@drawable/checkbox_remember_password_selector" />

                    <TextView
                        android:id="@+id/text_student"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="40dp"
                        android:text="学生"
                        android:textColor="@color/text_color_second"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/margin_10"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/check_remember_password"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:paddingTop="@dimen/dp_10"
                        android:paddingEnd="@dimen/dp_20"
                        android:paddingBottom="@dimen/dp_10"
                        android:src="@drawable/checkbox_remember_password_selector" />

                    <TextView
                        android:id="@+id/text_remember_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-10dp"
                        android:gravity="center_vertical"
                        android:text="@string/remember_password"
                        android:textColor="@color/text_color_second"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>

                <Button
                    android:id="@+id/bt_login"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:background="@drawable/login_bt_login"
                    android:padding="10dp"
                    android:text="@string/login"
                    android:textColor="@color/white"
                    android:textSize="16sp" />


            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>
</FrameLayout>